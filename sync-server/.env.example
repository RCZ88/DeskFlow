# Sync Server Environment Variables
PORT=8787
HOST=0.0.0.0

# Database (libSQL — local file or remote URL)
DATABASE_URL=file:./data/sync.db
# DATABASE_AUTH_TOKEN=your-libsql-auth-token

# JWT for user auth (access tokens)
JWT_SECRET=change-me-to-a-256-bit-base64url-string

# Relay ticket secret (shared with desktop Electron app)
RELAY_TICKET_SECRET=change-me-to-a-256-bit-base64url-string

# CORS origins (comma-separated)
CORS_ORIGINS=*
